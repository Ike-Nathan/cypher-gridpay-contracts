{
  "name": "@cypher-gridpay/contracts-sdk",
  "version": "0.1.0",
  "description": "Auto-generated, type-safe TypeScript client bindings for the Cypher GridPay Stellar Soroban smart contracts (payment, escrow, refund, admin).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=13"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnephraim949-web/cypher-gridpay-contracts.git",
    "directory": "sdk/typescript"
  }
}